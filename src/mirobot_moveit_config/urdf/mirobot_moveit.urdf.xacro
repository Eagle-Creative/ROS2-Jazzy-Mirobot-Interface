<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0
     MoveIt model of the WLKATA Mirobot: mirobot_description/urdf/mirobot_urdf_2.urdf plus a tool
     centre point frame (mirobot_tcp). -->
<robot name="mirobot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find mirobot_description)/urdf/mirobot_urdf_2.urdf"/>

  <!-- Tool centre point.
       The firmware's Cartesian TCP is 8 mm beyond Link6's origin along the tool direction
       (Link6 -Z): at home the URDF Link6 is at z 238.7 mm, the firmware reports 230.72 mm, and
       all six joint directions match the firmware (checked against its Cartesian output).
       mirobot_tcp's Z points along the tool (down at home).

       That firmware point is the J6 flange face where the tool adapter is bolted on (measured on a
       real unit: ~230 mm above the mounting surface at home; base_link z 0 = base underside).

       tool_length = distance from the firmware point (flange face) to the tool tip.
       WLKATA suction cup assembly (adapter + vacuum block + cup): 0.0365 (default).
       Until 2026-10-26 this said 0.0575 = 52 mm measured from where the orange wrist cover ends,
       assumed 5.5 mm beyond the firmware point; the cover actually ends ~15 mm *before* it, so
       that value was 21 mm too long. -->
  <xacro:arg name="tool_length" default="0.0365"/>
  <link name="mirobot_tcp"/>
  <joint name="mirobot_tcp_joint" type="fixed">
    <parent link="Link6"/>
    <child link="mirobot_tcp"/>
    <origin xyz="0 0 ${-0.008 - $(arg tool_length)}" rpy="3.14159265 0 0"/>
  </joint>

</robot>
